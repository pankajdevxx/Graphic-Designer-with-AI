# ==========================================
# PixelGenCreativity — Environment Configuration
# ==========================================

# ----------------- BACKEND -----------------
DJANGO_SECRET_KEY=pixelgen-insecure-development-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Settings (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
# Set DB_ENGINE=mysql for MySQL 8.0, or DB_ENGINE=sqlite for local standalone SQLite
DB_ENGINE=mysql
DB_NAME=pixelgencreativity_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# ----------------- FRONTEND ----------------
VITE_API_URL=http://localhost:8000/api

